# Copiar como apps/api/.env
# Debe coincidir con POSTGRES_PASSWORD y POSTGRES_PORT del .env de la raíz
DATABASE_URL="postgresql://postgres:cambia-esta-clave@localhost:5433/puntos_dev?schema=public"

PORT=3001

# Genera un secreto con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900

CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
